{
  "workload": "sft",
  "num_processes": 1,
  "representation": "relative",
  "status": "native framework; GPU validation pending",
  "trainer_args": {
    "use_liger_kernel": false,
    "lora_enable": true,
    "use_dora": false,
    "lora_namespan_exclude": "['lm_head', 'embed_tokens']",
    "lora_rank": 64,
    "lora_alpha": 128,
    "lora_dropout": 0.05,
    "num_lora_modules": -1,
    "deepspeed": "time_r1/configs/deepspeed/zero3.json",
    "remove_unused_columns": false,
    "freeze_vision_tower": true,
    "freeze_llm": true,
    "freeze_merger": false,
    "bf16": true,
    "fp16": false,
    "disable_flash_attn2": true,
    "num_train_epochs": 5,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "video_min_pixels": 100352,
    "video_max_pixels": 109760,
    "video_max_frames": 700,
    "max_seq_length": 131072,
    "fps": 2,
    "learning_rate": 1e-05,
    "adam_beta1": 0.9,
